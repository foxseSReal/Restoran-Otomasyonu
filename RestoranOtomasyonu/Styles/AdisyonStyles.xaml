<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Style x:Key="AdisyonBorder" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Margin" Value="0 0 0 20"/>
        <Setter Property="CornerRadius" Value="0 0 0 0"/>
        <Setter Property="Width" Value="500"/>
        <Setter Property="Height" Value="800"/>
    </Style>
    
    <Style x:Key="AdisyonYBorder" TargetType="Border">
        <Setter Property="Background" Value="#50000000"/>
        <Setter Property="Margin" Value="20 0 0 20"/>
        <Setter Property="CornerRadius" Value="40 0 0 40"/>
        <Setter Property="Width" Value="80"/>
        <Setter Property="Height" Value="800"/>
    </Style>
    <Style x:Key="AdisyonItemsBorder" TargetType="Border">
        <Setter Property="Background" Value="#50000000"/>
        <Setter Property="Margin" Value="0 2 0 0"/>
        <Setter Property="CornerRadius" Value="0 40 40 0"/>
        <Setter Property="Width" Value="917"/>
        <Setter Property="Height" Value="800"/>
    </Style>
</ResourceDictionary>