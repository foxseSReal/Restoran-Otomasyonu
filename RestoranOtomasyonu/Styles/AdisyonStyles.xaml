<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="AdisyonBorder" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Margin" Value="0 0 0 20"/>
        <Setter Property="CornerRadius" Value="0 0 0 0"/>
        <Setter Property="Width" Value="500"/>
        <Setter Property="Height" Value="800"/>
    </Style>

    <Style x:Key="AdisyonYonetimBorder" TargetType="Border">
        <Setter Property="Background" Value="#50000000"/>
        <Setter Property="Margin" Value="20 0 0 20"/>
        <Setter Property="CornerRadius" Value="40 0 0 40"/>
        <Setter Property="Width" Value="80"/>
        <Setter Property="Height" Value="800"/>
    </Style>
    <Style x:Key="AdisyonItemsBorder" TargetType="Border">
        <Setter Property="Background" Value="#50000000"/>
        <Setter Property="Margin" Value="0 2 0 0"/>
        <Setter Property="CornerRadius" Value="0 40 40 0"/>
        <Setter Property="Width" Value="917"/>
        <Setter Property="Height" Value="800"/>
    </Style>

    <Style x:Key="OdemeOnaylamaButtonu" TargetType="Button">
        <Setter Property="Height" Value="70"/>
        <Setter Property="Width" Value="200"/>
        <Setter Property="Background" Value="Green"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="FontFamily" Value="Segoe UI Black"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButonCercevesi" 
                Background="{TemplateBinding Background}" 
                BorderBrush="{TemplateBinding BorderBrush}" 
                BorderThickness="1" 
                CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter TargetName="ButonCercevesi" Property="Background" Value="OrangeRed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--AdisyonYonetimButtons-->
    <Style x:Key="AdisyonYonetimButtons" TargetType="Button">
        <Setter Property="Height" Value="100"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="FontFamily" Value="Segoe UI Black"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButonCercevesi" 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter TargetName="ButonCercevesi" Property="Background" Value="#30dcdcdc"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!---->

    <Style x:Key="AYonetimText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!--ListView-->
    <DataTemplate x:Key="ListViewItemTemplate1">
        <Border BorderBrush="#DFDFDF" BorderThickness="0 0 0 2" Padding="12,8" Background="Transparent">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="310"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Border Background="#FFF1F1" CornerRadius="5" Padding="4,2" MinWidth="35">
                        <TextBlock Text="{Binding Adet, StringFormat='{}{0}x'}" 
                               Foreground="Red" FontWeight="Bold" FontSize="18" 
                               HorizontalAlignment="Center" FontFamily="Segoe UI"/>
                    </Border>

                    <Border Background="#27AE60" 
                        CornerRadius="10" 
                        MinWidth="20" Height="20" 
                        VerticalAlignment="Top" 
                        HorizontalAlignment="Right" 
                        Margin="0,-10,-10,0">
                        <TextBlock Text="{Binding SecilenAdet}" 
                               Foreground="White" FontSize="11" FontWeight="Bold" 
                               HorizontalAlignment="Center" VerticalAlignment="Center" 
                               FontFamily="Segoe UI"/>

                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SecilenAdet}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Grid>

                <Grid Grid.Column="1" Margin="15 0 10 0" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding UrunAdi}" 
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" 
                           FontWeight="SemiBold" FontSize="18" Foreground="#333333" FontFamily="Segoe UI"/>
                    <TextBlock Grid.Row="1" Text="{Binding EkstraNot}" TextWrapping="WrapWithOverflow" 
                           FontSize="12" Foreground="Gray" FontFamily="Segoe UI"/>
                </Grid>

                <TextBlock Grid.Column="2" Text="{Binding Toplam, StringFormat='{}₺ {0:N2}'}" 
                       HorizontalAlignment="Right" FontWeight="Bold" FontSize="20" 
                       Foreground="#27AE60" VerticalAlignment="Center" FontFamily="Segoe UI"/>
            </Grid>
        </Border>
    </DataTemplate>

    <!--Masa Yazisi-->
    <Style x:Key="AdisyonMasaYazisiBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brass300Brush}"/>
        <Setter Property="Height" Value="60"/>
        <Setter Property="Width" Value="500"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="CornerRadius" Value="0 0 20 20"/>
    </Style>

    <Style x:Key="MasaYazisiTextBlock" TargetType="TextBlock">
        <Setter Property="FontSize" Value="36"/>
        <Setter Property="FontFamily" Value="Segoe UI Black"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Text" Value="{Binding MasaNo, StringFormat='Masa {0}'}"/>
    </Style>
    <!---->


    <!--Frame-->
    <Style x:Key="NavigasyonFrame" TargetType="Frame">
        <Setter Property="NavigationUIVisibility" Value="Hidden"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Frame">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource AdisyonMasaYazisiBorder}" Grid.Row="0" Background="{StaticResource Brass300Brush}" Padding="10,8">
                            <StackPanel Orientation="Horizontal">

                                <Button Command="NavigationCommands.BrowseBack" 
                                        Content="◀ Geri" 
                                        Background="#E74C3C" Foreground="White" 
                                        FontWeight="Bold" Padding="15,5" Margin="0,0,10,0"
                                        BorderThickness="0" Cursor="Hand"/>

                                <Button Command="NavigationCommands.BrowseForward" 
                                        Content="İleri ▶" 
                                        Background="#3498DB" Foreground="White" 
                                        FontWeight="Bold" Padding="15,5"
                                        BorderThickness="0" Cursor="Hand"/>

                                <TextBlock Text="Sipariş Menüsü" 
                                           Foreground="White" FontSize="16" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="20,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <ContentPresenter Grid.Row="1" ClipToBounds="True"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!---->

</ResourceDictionary>