<Window x:Class="RestoranOtomasyonu.MasalarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RestoranOtomasyonu"
        Background="{StaticResource MainBackgroundBrush}"
        Style="{StaticResource MaterialDesignWindow}"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Title="Masalar" WindowStyle="None" ResizeMode="NoResize" Width="1537" Height="864" WindowState="Maximized">

    <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <!--Title Bar-->
        <Grid x:Name="TitleBar" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0 10 0 0" Orientation="Horizontal" Grid.Row="0">
                <materialDesign:PackIcon Kind="StorefrontOutline" Width="50" Height="30" Foreground="White"/>
                <TextBlock Text="RESTORAN  TAKİP" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="White" FontWeight="SemiBold" FontFamily="/NewFonts/Pacifico-Regular.ttf#Pacifico"/>
            </StackPanel>
            <StackPanel Margin="50 0 0 0" Orientation="Horizontal" Grid.Column="2">
                <Button Style="{StaticResource MinimizeButton}" Click="MinimizeButton_Click">
                    <materialDesign:PackIcon Foreground="Black" Kind="Minus" Width="25" Height="25"/>
                </Button>
                <Button Style="{StaticResource CloseButton}" Click="CloseButton_Click">
                    <materialDesign:PackIcon Foreground="Black" Kind="Close" Width="25" Height="25"/>
                </Button>
            </StackPanel>
        </Grid>

        <!--Orta Grid-->
        <Grid Grid.Column="1" Grid.Row="0" Grid.RowSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <!--Salon-->
            <Border Padding="0 0 0 0">
                <ScrollViewer VerticalScrollBarVisibility="Hidden" ScrollViewer.PanningMode="Both">
                    <WrapPanel Margin="0 20 0 0" x:Name="MasaPanel" Orientation="Horizontal" UseLayoutRounding="True" ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <!--Masalar Buraya Geliyor-->
                    </WrapPanel>
                </ScrollViewer>
            </Border>
            <!---->
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!--Sag Kontrol Paneli-->
                <StackPanel Grid.Column="1"  Grid.Row="1">
                    <!--Kontrol Paneli-->
                    <Border Padding="0 20 0 0" Style="{StaticResource KontrolBorderSalon}">
                        <StackPanel Orientation="Vertical">
                            <Button ToolTip="Yönetim Paneline Geç" Style="{StaticResource KontrolButtons}" Click="YonetimClick">
                                <materialDesign:PackIcon Kind="ArrowRightBold" Width="50" Height="50"/>
                            </Button>
                            <Button x:Name="MasaEkle" Click="MasaEkle_Click" ToolTip="Masa Ekle" Style="{StaticResource KontrolButtons}">
                                <materialDesign:PackIcon Kind="TableAdd" Width="50" Height="50"/>
                            </Button>
                            <Button x:Name="KategoriEkle" ToolTip="Kategori Ekle" Style="{StaticResource KontrolButtons}">
                                <materialDesign:PackIcon Kind="Food" Width="50" Height="50"/>
                            </Button>
                            <Button x:Name="UrunEkle" Click="UrunEkle_Click" ToolTip="Ürün Ekle" Style="{StaticResource KontrolButtons}">
                                <materialDesign:PackIcon Kind="AddBold" Width="50" Height="50"/>
                            </Button>
                            <Button x:Name="FiyatGuncelle" ToolTip="Fiyat Güncelle" Style="{StaticResource KontrolButtons}">
                                <materialDesign:PackIcon Kind="CashSync" Width="50" Height="50"/>
                            </Button>
                        </StackPanel>
                    </Border>

                </StackPanel>
                <!---->
            </Grid>
        </Grid>

        <!--Tarih Saat-->
        <Grid Grid.Column="0" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="230"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Vertical">
                <TextBlock x:Name="_saat" FontSize="100" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" FontFamily="/NewFonts/Pacifico-Regular.ttf#Pacifico"/>
                <TextBlock x:Name="_tarih" FontSize="22" VerticalAlignment="Center" Foreground="White" HorizontalAlignment="Center" FontFamily="/NewFonts/Pacifico-Regular.ttf#Pacifico"/>
                <Separator Width="200" Background="White"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Vertical">
                <Button Content="Paketleri Git" Margin="0 20 0 10" Background="CadetBlue" BorderBrush="CadetBlue" materialDesign:ButtonAssist.CornerRadius="20" Width="150" Click="PaketGoster"/>
                <Separator Width="200" Background="White" />
                <Button Content="Salona Git" Width="150" materialDesign:ButtonAssist.CornerRadius="20" Background="#dcdcdc" BorderBrush="#dcdcdc" Margin="0 10 0 0" Click="Window_Loaded"/>

                <!---->
                <Border Style="{StaticResource DashboardCardStyle}" Width="280" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,20,0">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="GÜNÜN CİROSU" Foreground="#88FFFFFF" FontSize="16" FontWeight="Bold"/>
                            <TextBlock x:Name="txtGunlukCiro" Text="₺ 0,00" Foreground="#FF00FF7F" FontSize="30" FontWeight="ExtraBold" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Rectangle Height="3" Fill="#22FFFFFF" Margin="0,0,0,12"/>

                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Ellipse Width="8" Height="8" Fill="#FF00FF7F" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="AÇIK MASALAR" Foreground="#88FFFFFF" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock x:Name="txtAcikMasaSayisi" Text="0" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="ADET" Foreground="#44FFFFFF" FontSize="10" FontWeight="Bold" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!---->
            </StackPanel>
        </Grid>
    </Grid>
</Window>
