<Window x:Class="RestoranOtomasyonu.OtherWindows.MusteriDetay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Style="{StaticResource MaterialDesignWindow}"
        xmlns:local="clr-namespace:RestoranOtomasyonu.OtherWindows"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Title="MusteriDetay" Height="614" Width="856" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" WindowStyle="None">
    <Grid>
        <StackPanel Orientation="Vertical">
            <!--Kapatma Buttonu-->
            <Button HorizontalAlignment="Right" Width="50" Height="30" Click="Close_Click">
                <materialDesign:PackIcon VerticalAlignment="Center" Kind="Close" Width="20" Height="30"/>
            </Button>
            <!---->
            <!--Firma DataGrid-->
            <TextBlock Text="Müşteriler" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="Arial Black" FontSize="24" Foreground="LimeGreen"/>
            <DataGrid IsReadOnly="True" x:Name="MusteriD_DataGrid" Margin="0 10 0 0" CanUserAddRows="False" CanUserDeleteRows="False" Focusable="True" Width="830" Height="250"  SelectionChanged="Musteri_DataGrid_SelectionChanged" />
            <!---->
            <!--Urunler DataGrid-->
            <TextBlock Text="Detayler" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="Arial Black" FontSize="24" Foreground="LimeGreen"/>
            <DataGrid IsReadOnly="True" x:Name="Detay_DataGrid" Margin="0 10 0 0" CanUserAddRows="False" CanUserDeleteRows="False" Focusable="True" Width="830" Height="250"/>
            <!---->
        </StackPanel>
    </Grid>
</Window>
