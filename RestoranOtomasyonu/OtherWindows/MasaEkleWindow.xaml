<Window x:Class="RestoranOtomasyonu.OtherWindows.MasaEkleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Yeni Masa Ekle" Height="250" Width="400"
        Topmost="True"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Yeni Masa Tanımla" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" Foreground="#2C3E50"/>

            <TextBlock Text="Masa Numarası" Margin="0,5" Foreground="#7F8C8D"/>
            <TextBox x:Name="txtMasaNo" materialDesign:TextFieldAssist.SuffixText="Sadece Masa Numarası Girin" Height="35" VerticalContentAlignment="Center" FontSize="16" Padding="5,0"/>

            <UniformGrid Columns="2" Margin="0,25,0,0">
                <Button Content="İptal" Click="Button_Click" Height="40" Margin="0,0,5,0" Background="#E74C3C" Foreground="White" Cursor="Hand"/>
                <Button Content="Masayı Kaydet" Click="BtnKaydet_Click" Height="40" Margin="5,0,0,0" Background="#2ECC71" BorderBrush="Transparent" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
            </UniformGrid>
        </StackPanel>
    </Grid>
</Window>