<Window x:Class="RestoranOtomasyonu.OtherWindows.Adisyon"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RestoranOtomasyonu.OtherWindows"
        mc:Ignorable="d"
        Style="{StaticResource MaterialDesignWindow}"
        Background="{StaticResource MainBackgroundBrush}"
        Loaded="Adisyon_Loaded"
        Title="Adisyon" WindowStyle="None" ResizeMode="NoResize" Width="1537" Height="864" WindowState="Maximized">
    <Viewbox>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="500"/>
                <ColumnDefinition Width="935"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="824"/>
            </Grid.RowDefinitions>
            <Grid x:Name="TitleBar" Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0 10 0 0" Orientation="Horizontal" Grid.Row="0">
                    <materialDesign:PackIcon Kind="StorefrontOutline" Width="50" Height="30" Foreground="White"/>
                    <TextBlock Text="RESTORAN  TAKİP" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="White" FontWeight="SemiBold" FontFamily="/NewFonts/Pacifico-Regular.ttf#Pacifico"/>
                </StackPanel>
                <StackPanel Margin="0 0 0 0" Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="2">
                    <Button Style="{StaticResource CloseButton}" Click="CloseButton_Click">
                        <materialDesign:PackIcon Foreground="Black" Kind="Close" Width="25" Height="25"/>
                    </Button>
                </StackPanel>
            </Grid>
            <Border  Style="{StaticResource AdisyonYonetimBorder}" Grid.Column="0" Grid.Row="1">
                <StackPanel Orientation="Vertical">
                    <!--Burada Fis kesme , urun iptal temizleme , indirim , ikram butonlari olacak-->
                    <Separator Margin="0 60 0 0" Background="#40000000"/>
                    <Button x:Name="RezervasyonButton" Click="RezervasyonButton_Click" Style="{StaticResource AdisyonYonetimButtons}">
                        <StackPanel>
                            <TextBlock Text="Rezervasyon" Style="{StaticResource AYonetimText}"/>
                            <materialDesign:PackIcon Kind="BookEdit" Width="40" Height="40" Foreground="White" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Separator Margin="0 0 0 0" Background="#40000000"/>
                    <Button x:Name="UrunIptalButton" Click="btnIptal_Click" Style="{StaticResource AdisyonYonetimButtons}">
                        <StackPanel>
                            <TextBlock Text="Ürün İptal" Style="{StaticResource AYonetimText}"/>
                            <materialDesign:PackIcon Kind="MinusCircle" Width="40" Height="40" Foreground="White" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Separator Margin="0 0 0 0" Background="#40000000"/>
                    <Button x:Name="IndirimButton" Style="{StaticResource AdisyonYonetimButtons}">
                        <StackPanel>
                            <TextBlock Text="İndirim" Style="{StaticResource AYonetimText}"/>
                            <materialDesign:PackIcon Kind="Sale" Width="40" Height="40" Foreground="White" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Separator Margin="0 0 0 0" Background="#40000000"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource AdisyonBorder}" Grid.Column="1" Grid.Row="1">
                <StackPanel Orientation="Vertical">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="60"/>
                            <RowDefinition Height="630"/>
                            <RowDefinition Height="110"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource AdisyonMasaYazisiBorder}">
                            <TextBlock x:Name="AdisyonMasaYazisi" FontSize="36" FontFamily="Segoe UI Black" HorizontalAlignment="Center"/>
                        </Border>
                        <!--Siparislerin yazacagi kisim birasi buraya listelenecek-->
                        <ListView PreviewMouseLeftButtonDown="SiparisList_PreviewMouseLeftButtonDown" Grid.Row="1" x:Name="SiparisList" ItemTemplate="{DynamicResource ListViewItemTemplate1}" ItemsPanel="{DynamicResource ListViewItemsPanel1}" ItemContainerStyle="{DynamicResource ListViewItemContainerStyle1}"/>
                        <!--Siparislerin yazacagi kisim birasi buraya listelenecek-->
                        <Border Grid.Row="2" Background="{StaticResource AmberBrush}" CornerRadius="20 20 0 0" VerticalAlignment="Bottom" Height="100">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Button Style="{StaticResource OdemeOnaylamaButtonu}" x:Name="OnaylaButtonu" Content="Onayla" Click="btnOnayla_Click"/>
                                    <Button Style="{StaticResource OdemeOnaylamaButtonu}" Background="Red" x:Name="OdemeButtonu" Content="Ödeme Al" Click="OdemeButtonu_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="txtGenelToplam" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="36" Foreground="#27AE60" FontWeight="Bold" Text="₺ 0,00"/>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!--Kategoriler Listelenecek kisim-->
            <StackPanel Grid.Column="2" Grid.Row="1" Margin="0 0 20 0">
                <Border Style="{StaticResource AdisyonItemsBorder}">
                    <Frame Style="{DynamicResource NavigasyonFrame}" x:Name="MenuFrame"/>
                </Border>
            </StackPanel>
        </Grid>
    </Viewbox>
</Window>
