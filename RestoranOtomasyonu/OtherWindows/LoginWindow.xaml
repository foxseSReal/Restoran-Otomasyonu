<Window x:Class="RestoranOtomasyonu.OtherWindows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:RestoranOtomasyonu.OtherWindows"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Title="LoginWindow" Height="600" Width="700">
    <Grid Style="{StaticResource Login_arkaPlan}">
        <StackPanel Orientation="Vertical">

            <TextBlock x:Name="Saat" Margin="0 30 0 0" FontSize="48" FontFamily="Arial" Foreground="Black" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <Separator Width="500" Height="20" Background="White"/>
            <StackPanel Margin="0 100 0 0"  Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBox x:Name="txtUsername" Style="{StaticResource MaterialDesignFilledTextBox}" Foreground="White" materialDesign:TextFieldAssist.UnderlineBrush="White" materialDesign:HintAssist.Foreground="White" MaxLength="18" materialDesign:HintAssist.Hint="Kullanıcı Adı" materialDesign:TextFieldAssist.HasClearButton="True" FontSize="24" Width="300"/>
            </StackPanel>
            <StackPanel Margin="0 30 0 0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <PasswordBox x:Name="PasswordBox" materialDesign:HintAssist.Hint="Şifre" materialDesign:TextFieldAssist.HasClearButton="True" materialDesign:TextFieldAssist.UnderlineBrush="White" materialDesign:HintAssist.Foreground="White" Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" Width="300" Height="50" Foreground="White" MaxLength="18" FontSize="24"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0 10 0 0 ">
                <Button Margin="100 20 0 0" Click="btnGiris_Click" Content="Giriş Yap" FontSize="24" FontWeight="Bold" Style="{StaticResource MaterialDesignFlatDarkBgButton}" Width="200" Height="50" materialDesign:ButtonAssist.CornerRadius="20"/>
                <Button Margin="100 20 0 0" Click="AppClose" Content="Çıkış Yap" FontSize="24" FontWeight="Bold" Style="{StaticResource MaterialDesignFlatDarkBgButton}" Width="200" Height="50" materialDesign:ButtonAssist.CornerRadius="20"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
