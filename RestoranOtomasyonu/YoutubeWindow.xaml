<Window x:Class="RestoranOtomasyonu.YouTubeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="YouTube Müzik" Height="864" Width="1537" 
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
        Background="#0F0F0F">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#181818">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1">
                    <Button ToolTip="Geri" Click="BtnPageBack_Click" Width="60" Style="{StaticResource MaterialDesignPaperLightButton}" materialDesign:ButtonAssist.CornerRadius="0 0 0 20" Margin="0,0,0,0" Height="39"
            Background="Transparent" Foreground="White" BorderBrush="AliceBlue" FontWeight="Bold" Cursor="Hand"
            BorderThickness="1">
                        <materialDesign:PackIcon Kind="ArrowLeft" Width="30" Height="30" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Button ToolTip="İleri" Width="60" Click="BtnPageForward_Click" Style="{StaticResource MaterialDesignPaperLightButton}" materialDesign:ButtonAssist.CornerRadius="0 0 20 0" Margin="0,0,0,0" Height="39"
            Background="Transparent" Foreground="White" BorderBrush="AliceBlue" FontWeight="Bold" Cursor="Hand"
            BorderThickness="1">
                        <materialDesign:PackIcon Kind="ArrowRight" Width="30" Height="30" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <Button ToolTip="Çıkış" Width="50" VerticalAlignment="Top" Style="{StaticResource MaterialDesignPaperLightButton}" materialDesign:ButtonAssist.CornerRadius="0 0 0 20" HorizontalAlignment="Right" Margin="0,0,0,0" Height="39"
            Background="#D32F2F" Foreground="White" FontWeight="Bold" Cursor="Hand"
            BorderThickness="0" Click="BtnClose_Click">
                        <materialDesign:PackIcon Kind="Close" Width="30" Height="30" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <wv2:WebView2 x:Name="YTWebView" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0"/>
    </Grid>
</Window>