<Page x:Class="RestoranOtomasyonu.Pages.OdemeSayfa"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RestoranOtomasyonu.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="824" d:DesignWidth="935"
      Title="OdemeSayfa">
    <Page.Triggers>
        <EventTrigger RoutedEvent="Page.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                     From="0" To="1" Duration="0:0:0.3" />
                    <ThicknessAnimation Storyboard.TargetProperty="Margin" 
                        From="0,0,0,800" To="0,0,0,0" Duration="0:0:1" 
                        DecelerationRatio="0.9" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="230"/>
            <RowDefinition Height="574"/>
        </Grid.RowDefinitions>

        <!--Odeme Geçmişi ve Kısa yollar-->
        <!--row0-->
        <Grid Grid.Row="0" Margin="0,0,0,0">
            <Border Background="#F0F1F8" Padding="10">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="CashRegister" Width="40" Height="40" Foreground="#4A4A68" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Ödeme Al" FontFamily="/Resources/Noto/Pacifico-Regular.ttf#Pacifico" FontSize="25" FontWeight="Bold" Foreground="#4A4A68" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">

                            <StackPanel Margin="20,0">
                                <TextBlock Text="İNDİRİM" FontSize="14" Foreground="#8E8EA9" FontWeight="Bold"/>
                                <TextBlock x:Name="txt_IndirimTutar" Text="₺0,00" FontSize="24" FontWeight="Bold" Foreground="#673AB7"/>
                            </StackPanel>

                            <StackPanel Margin="20,0">
                                <TextBlock Text="ÖDENEN TUTAR" FontSize="14" Foreground="#8E8EA9" FontWeight="Bold"/>
                                <TextBlock x:Name="txt_OdenenTutar" Text="₺0,00" FontSize="24" FontWeight="Bold" Foreground="#2D2D44"/>
                            </StackPanel>

                            <StackPanel Margin="20,0">
                                <TextBlock Text="KALAN TUTAR" FontSize="14" Foreground="#8E8EA9" FontWeight="Bold"/>
                                <TextBlock x:Name="txt_KalanTutar" Text="₺0,00" FontSize="24" FontWeight="Bold" Foreground="#E91E63"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Border Background="#5C5C7D" CornerRadius="15" Padding="20,0,0,20" Height="145">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <Button x:Name="BtnHizliTutar_5" Content="₺5" Click="QuickAmount_Click" Style="{StaticResource AmountButtonStyle}"/>
                                    <Button x:Name="BtnHizliTutar_10" Content="₺10" Click="QuickAmount_Click" Style="{StaticResource AmountButtonStyle}"/>
                                    <Button x:Name="BtnHizliTutar_20" Content="₺20" Click="QuickAmount_Click" Style="{StaticResource AmountButtonStyle}"/>
                                    <Button x:Name="BtnHizliTutar_50" Content="₺50" Click="QuickAmount_Click" Style="{StaticResource AmountButtonStyle}"/>
                                    <Button x:Name="BtnHizliTutar_100" Content="₺100" Click="QuickAmount_Click" Style="{StaticResource AmountButtonStyle}"/>
                                    <Button x:Name="BtnHizliTutar_200" Content="₺200" Click="QuickAmount_Click" Style="{StaticResource AmountButtonStyle}"/>
                                </StackPanel>

                                <Button x:Name="TamaminiOdemeBtn" Click="AllAmount_Click" Content="Bütün Ödemeyi Al" Style="{StaticResource PayAllButtonStyle}" HorizontalAlignment="Right" Height="55" Margin="5,-56,0,8"/>
                            </DockPanel>
                            <ScrollViewer Grid.Row="1"  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" Margin="0,5,20,0">
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
        <!--row1-->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!--Odeme Kisayol Butonlari-->
            <StackPanel Background="#F0F1F8" Grid.Column="0">
                <Button x:Name="btn_Kart" Click="PaymentMethod_Click" Content="KART" Style="{StaticResource OdemelerButtonStyle}"/>
                <Button x:Name="btn_Nakit" Click="PaymentMethod_Click" Content="NAKIT" Style="{StaticResource OdemelerButtonStyle}"/>
                <Button x:Name="btn_İndirim" Click="PaymentMethod_Click" Content="İNDİRİM" Style="{StaticResource OdemelerButtonStyle}"/>
                <Button x:Name="btn_Ticket" Click="PaymentMethod_Click" Content="TICKET" Style="{StaticResource OdemelerButtonStyle}"/>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <Border Background="#F0F1F8" Padding="20" Width="685" Height="574" HorizontalAlignment="Center">
                    <StackPanel>
                        <Border Style="{StaticResource DisplayBorderStyle}">
                            <Grid Margin="15,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Ellipse Fill="ForestGreen" Width="20" Height="20" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="txt_OdemeSekli" Text="NAKIT" Foreground="#8E8EA9" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="txt_Tutar" Text="₺0,00" Foreground="#2D2D44" FontSize="35" FontWeight="Bold" 
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="100"/>
                                <RowDefinition Height="100"/>
                                <RowDefinition Height="100"/>
                                <RowDefinition Height="100"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Content="7" Click="Num_Click" Grid.Row="0" Grid.Column="0" Style="{StaticResource NumpadButtonStyle}"/>
                            <Button Content="8" Click="Num_Click" Grid.Row="0" Grid.Column="1" Style="{StaticResource NumpadButtonStyle}"/>
                            <Button Content="9" Click="Num_Click" Grid.Row="0" Grid.Column="2" Style="{StaticResource NumpadButtonStyle}"/>
                            <Button Content="⌫" Click="Delete_Click" Grid.Row="0" Grid.Column="3" Style="{StaticResource NumpadButtonStyle}"/>

                            <Button Content="4" Click="Num_Click" Grid.Row="1" Grid.Column="0" Style="{StaticResource NumpadButtonStyle}"/>
                            <Button Content="5" Click="Num_Click" Grid.Row="1" Grid.Column="1" Style="{StaticResource NumpadButtonStyle}"/>
                            <Button Content="6" Click="Num_Click" Grid.Row="1" Grid.Column="2" Style="{StaticResource NumpadButtonStyle}"/>
                            <Button Content="C" Click="Clear_Click" Grid.Row="1" Grid.Column="3" Style="{StaticResource NumpadButtonStyle}"/>

                            <Button Content="1" Click="Num_Click" Grid.Row="2" Grid.Column="0" Style="{StaticResource NumpadButtonStyle}"/>
                            <Button Content="2" Click="Num_Click" Grid.Row="2" Grid.Column="1" Style="{StaticResource NumpadButtonStyle}"/>
                            <Button Content="3" Click="Num_Click" Grid.Row="2" Grid.Column="2" Style="{StaticResource NumpadButtonStyle}"/>

                            <Button Content="00" Click="Num_Click" Grid.Row="3" Grid.Column="0" Style="{StaticResource NumpadButtonStyle}"/>
                            <Button Content="0"  Click="Num_Click" Grid.Row="3" Grid.Column="1" Style="{StaticResource NumpadButtonStyle}"/>
                            <Button Content="."  Click="Num_Click" Grid.Row="3" Grid.Column="2" Style="{StaticResource NumpadButtonStyle}"/>

                            <Button Click="Enter_Click" Grid.Row="2" Grid.Column="3" Grid.RowSpan="2" Style="{StaticResource EnterButtonStyle}">
                                <StackPanel>
                                    <TextBlock Text="↵" FontSize="35" HorizontalAlignment="Center" Margin="0,-5,0,0"/>
                                    <TextBlock Text="ENTER" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

        </Grid>
    </Grid>
</Page>
