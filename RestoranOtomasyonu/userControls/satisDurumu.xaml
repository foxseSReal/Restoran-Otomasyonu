<UserControl x:Class="RestoranOtomasyonu.userControls.satisDurumu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RestoranOtomasyonu.userControls"
             mc:Ignorable="d" 
             Loaded="UserControl_Loaded"
             d:DesignHeight="784" d:DesignWidth="1036">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <Grid Grid.Row="0" Margin="0 0 0 15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="10" Margin="5 15 5 0" Background="White" materialDesign:ElevationAssist.Elevation="Dp3" Padding="10">
                <StackPanel>
                    <TextBlock Text="Bugünkü Net Kasa" Foreground="#666" FontSize="13"/>
                    <TextBlock x:Name="lblKasaBugun" Text="₺0,00" FontSize="22" FontWeight="Bold" Foreground="#2ecc71"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" CornerRadius="10" Margin="5 15 5 0" Background="White" materialDesign:ElevationAssist.Elevation="Dp3" Padding="10">
                <StackPanel>
                    <TextBlock Text="Aylık Toplam Gelir" Foreground="#666" FontSize="13"/>
                    <TextBlock x:Name="lblGelirAylik" Text="₺0,00" FontSize="22" FontWeight="Bold" Foreground="#1976D2"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" CornerRadius="10" Margin="5 15 5 0" Background="White" materialDesign:ElevationAssist.Elevation="Dp3" Padding="10">
                <StackPanel>
                    <TextBlock Text="Aylık Toplam Gider" Foreground="#666" FontSize="13"/>
                    <TextBlock x:Name="lblGiderAylik" Text="₺0,00" FontSize="22" FontWeight="Bold" Foreground="#e74c3c"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" CornerRadius="10" Margin="5 15 5 0" Background="White" materialDesign:ElevationAssist.Elevation="Dp3" Padding="10">
                <StackPanel>
                    <TextBlock Text="Toplam İşlem Sayısı" Foreground="#666" FontSize="13"/>
                    <TextBlock x:Name="lblToplamIslem" Text="0" FontSize="22" FontWeight="Bold" Foreground="#212121"/>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0 0 0 15" HorizontalAlignment="Center">
            <DatePicker x:Name="dtBaslangic" Width="150" Margin="10 0" materialDesign:HintAssist.Hint="Başlangıç" Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>
            <DatePicker x:Name="dtBitis" Width="150" Margin="10 0" materialDesign:HintAssist.Hint="Bitiş" Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>
            <TextBox x:Name="txtKasaAra" Width="180" Margin="10 0" materialDesign:HintAssist.Hint="Açıklamada Ara..." Style="{StaticResource MaterialDesignFloatingHintTextBox}" TextChanged="txtKasaAra_TextChanged" />
            <Button Content="Sorgula" Click="btnSorgula_Click" Margin="10 0" Style="{StaticResource MaterialDesignRaisedDarkButton}"/>
            <Button Content="Temizle" Click="btnTemizle_Click" Style="{StaticResource MaterialDesignRaisedLightButton}"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Gelir Hareketleri (Satışlar vb.)" Margin="5" materialDesign:ColorZoneAssist.Mode="PrimaryLight">
                <DataGrid x:Name="dgGelirler" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tür" Binding="{Binding GelirTuru}" Width="Auto"/>
                        <DataGridTextColumn Header="Tutar" Binding="{Binding Tutar, StringFormat={}{0:C2}}" Width="Auto"/>
                        <DataGridTextColumn Header="Tarih" Binding="{Binding Tarih, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="Auto"/>
                        <DataGridTextColumn Header="Açıklama" Binding="{Binding Aciklama}" Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Gider Hareketleri (Stok, Ödemeler)" Margin="5">
                <DataGrid x:Name="dgGiderler" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tür" Binding="{Binding GiderTuru}" Width="Auto"/>
                        <DataGridTextColumn Header="Tutar" Binding="{Binding Tutar, StringFormat={}{0:C2}}" Width="Auto"/>
                        <DataGridTextColumn Header="Tarih" Binding="{Binding Tarih, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="Auto"/>
                        <DataGridTextColumn Header="Açıklama" Binding="{Binding Aciklama}" Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <Border Grid.Row="3" Background="White" CornerRadius="10" Padding="15" Margin="0 10 0 0" materialDesign:ElevationAssist.Elevation="Dp3">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="Genel Net Durum: " VerticalAlignment="Center" FontSize="18"/>
                    <TextBlock x:Name="lblNetDurum" Text="₺0,00" FontWeight="Bold" FontSize="26" Foreground="#2ecc71" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="* Tüm gelir ve giderler otomatik olarak bu ekrana yansıtılır." VerticalAlignment="Center" FontStyle="Italic" Foreground="Gray"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>